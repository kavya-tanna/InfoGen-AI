# ============================================
# InfoGen AI — Environment Configuration
# ============================================

# AI Provider: nvidia | openai | gemini | anthropic | demo
AI_PROVIDER=nvidia

# NVIDIA NIM API (primary - free models at build.nvidia.com)
NVIDIA_API_KEY=nvapi-your-key-here
MODEL_NAME=deepseek-ai/deepseek-v4-pro
FAST_MODEL_NAME=deepseek-ai/deepseek-v4-flash

# Alternative providers (optional)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Application
DEMO_MODE=false
MAX_FILE_SIZE_MB=25
DATABASE_URL=sqlite:///./infogen.db
LOG_LEVEL=INFO

# Security
CORS_ORIGINS=["*"]
RATE_LIMIT_PER_MINUTE=30
