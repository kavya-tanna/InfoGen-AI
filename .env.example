# Copy to backend/.env. Never commit real credentials.
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
MODEL_NAME=nvidia/nemotron-3.5-lightning-30b-a3b

# Optional Gemini fallback; leave GOOGLE_API_KEY blank to disable.
FALLBACK_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL_NAME=gemini-3.6-flash

# Total per-format deadline and primary-provider allowance, in seconds.
AI_TIMEOUT_SECONDS=150
PRIMARY_TIMEOUT_SECONDS=90
CORS_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]
