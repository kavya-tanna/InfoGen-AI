{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "InfoGen_AI.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/",
      "dest": "/InfoGen_AI.html"
    },
    {
      "src": "/(.*)",
      "dest": "/InfoGen_AI.html"
    }
  ]
}
